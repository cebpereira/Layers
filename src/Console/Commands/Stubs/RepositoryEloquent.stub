<?php

declare(strict_types=1);

namespace {{ namespace }};

{{ imports }}
use Illuminate\Database\Eloquent\Collection;

class {{ class }} implements {{ interface }}
{
    public function __construct(
        {{ propertyModifiers }} {{ model }} ${{ modelVariable }},
    ) {}

    /**
     * Store a new instance of {{ model }} in the database.
     *
     * @param  array<string, mixed>  $data
     */
    public function store(array $data): {{ model }}
    {
        return $this->{{ modelVariable }}->newQuery()->create($data);
    }

    /**
     * Get all instances of {{ model }} from the database.
     *
     * @param  array<int, string>|string  $columns
     * @param  array<array-key, mixed>|null  $filters
     * @return Collection<int, {{ model }}>
     */
    public function getList(array|string $columns = ['*'], ?array $filters = null): Collection
    {
        $query = $this->{{ modelVariable }}->newQuery();

        if ($filters) {
            $query->where($filters);
        }

        return $query->get($columns);
    }

    /**
     * Get the instance of {{ model }} with the given id.
     */
    public function get(int|string $id): ?{{ model }}
    {
        return $this->{{ modelVariable }}->newQuery()->find($id);
    }

    /**
     * Update the data of an instance of {{ model }}.
     *
     * @param  array<string, mixed>  $data
     */
    public function update(array $data, int|string $id): {{ model }}
    {
        ${{ modelVariable }} = $this->{{ modelVariable }}->newQuery()->findOrFail($id);
        ${{ modelVariable }}->update($data);

        return ${{ modelVariable }};
    }

    /**
     * Remove an instance of {{ model }} from the database.
     */
    public function destroy(int|string $id): bool
    {
        return (bool) $this->{{ modelVariable }}->newQuery()->findOrFail($id)->delete();
    }
}
